{
  "controller_type": "knuckles",
  "description": "VRC Nexus – Overlay ein/aus (Doppeldruck) + VR-Bewegung (Space Flight / Turn / Walk)",
  "name": "VRC Nexus",
  "bindings": {
    "/actions/nexus": {
      "sources": [
        {
          "path": "/user/hand/left/input/b",
          "mode": "button",
          "inputs": {
            "double": {
              "output": "/actions/nexus/in/toggle"
            }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/nexus/in/fly_left"
            },
            "double": {
              "output": "/actions/nexus/in/space_reset"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/nexus/in/fly_right"
            },
            "double": {
              "output": "/actions/nexus/in/gravity"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/nexus/in/turn_left"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/nexus/in/walk_right"
            }
          }
        }
      ]
    }
  }
}